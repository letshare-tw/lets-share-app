-- DEV-01B V5 controlled PG17.11 test. REVIEW ONLY. Never run via stateless HTTP.
-- Invoke with psql -X -v ON_ERROR_STOP=1 -v a_uid=... -v b_uid=... -v a_request=... -v b_request=... -v a_photo=... -v b_photo=... -f transaction_test.psql
-- This file contains no COMMIT. Run in one psql session; failures cause the connection to end and PG rollback.
\set ON_ERROR_STOP on
BEGIN;
SET LOCAL statement_timeout='45s';
SET LOCAL lock_timeout='3s';
SELECT pg_advisory_xact_lock(179413,5);
DO $$ BEGIN
 IF (SELECT submission_enabled FROM public.lx_share_submission_settings WHERE id=1) IS DISTINCT FROM false
 OR (SELECT agreement_version FROM public.lx_share_submission_settings WHERE id=1) IS NOT NULL
 OR (SELECT agreement_published_at FROM public.lx_share_submission_settings WHERE id=1) IS NOT NULL
 THEN RAISE EXCEPTION 'STOP: baseline settings not closed'; END IF;
 IF has_function_privilege('authenticated','public.lx_submit_share_request(uuid,text,boolean,boolean,boolean)','EXECUTE')
 OR has_function_privilege('anon','public.lx_submit_share_request(uuid,text,boolean,boolean,boolean)','EXECUTE')
 THEN RAISE EXCEPTION 'STOP: submit executable by member'; END IF;
END $$;
SELECT id FROM public.lx_share_submission_settings WHERE id=1 FOR UPDATE;
-- Variables are injected as quoted literals by psql; validate UUIDs/paths in the runner first.
SELECT set_config('dev01b.a_uid', :'a_uid', true),set_config('dev01b.b_uid', :'b_uid', true),set_config('dev01b.a_request', :'a_request', true),set_config('dev01b.b_request', :'b_request', true),set_config('dev01b.a_photo', :'a_photo', true),set_config('dev01b.b_photo', :'b_photo', true);
DO $$ DECLARE a uuid:=current_setting('dev01b.a_uid')::uuid; b uuid:=current_setting('dev01b.b_uid')::uuid; ra uuid:=current_setting('dev01b.a_request')::uuid; rb uuid:=current_setting('dev01b.b_request')::uuid; pa text:=current_setting('dev01b.a_photo'); pb text:=current_setting('dev01b.b_photo'); BEGIN
 IF a=b OR ra=rb OR pa=pb THEN RAISE EXCEPTION 'STOP: duplicate fixture identity';END IF;
 IF NOT EXISTS(SELECT 1 FROM auth.users WHERE id=a) OR NOT EXISTS(SELECT 1 FROM auth.users WHERE id=b) THEN RAISE EXCEPTION 'STOP: missing Auth users';END IF;
 IF NOT EXISTS(SELECT 1 FROM public.profiles WHERE id=a AND registration_completed_at IS NOT NULL) OR NOT EXISTS(SELECT 1 FROM public.profiles WHERE id=b AND registration_completed_at IS NOT NULL) THEN RAISE EXCEPTION 'STOP: missing completed profiles';END IF;
 IF NOT EXISTS(SELECT 1 FROM public.lx_share_requests WHERE id=ra AND sharer_user_id=a AND status='draft') OR NOT EXISTS(SELECT 1 FROM public.lx_share_requests WHERE id=rb AND sharer_user_id=b AND status='draft') THEN RAISE EXCEPTION 'STOP: missing own drafts';END IF;
 IF pa !~ ('^'||a::text||'/'||ra::text||'/[0-9]+-[a-z0-9]{1,8}\.png$') OR pb !~ ('^'||b::text||'/'||rb::text||'/[0-9]+-[a-z0-9]{1,8}\.png$') THEN RAISE EXCEPTION 'STOP: invalid fixture photo path';END IF;
 IF NOT EXISTS(SELECT 1 FROM storage.objects WHERE bucket_id='share-placement-photos' AND name=pa) OR NOT EXISTS(SELECT 1 FROM storage.objects WHERE bucket_id='share-placement-photos' AND name=pb) THEN RAISE EXCEPTION 'STOP: missing Storage objects';END IF;
END $$;
INSERT INTO public.lx_share_agreement_versions(version,content,published_at)
VALUES ('DEVTEST_ONLY_V5_TX_20261108',repeat('DEVTEST ONLY - NOT LEGAL TERMS. ',5),clock_timestamp());
INSERT INTO public.lx_approved_collection_points(id,name,address_text,enabled,approved_at)
VALUES ('11111111-1111-4111-8111-111111111115','DEVTEST ONLY POINT','DEVTEST ONLY 台南市虛構路200號',true,clock_timestamp());
UPDATE public.lx_share_submission_settings SET submission_enabled=true,agreement_version='DEVTEST_ONLY_V5_TX_20261108',agreement_published_at=clock_timestamp() WHERE id=1;
INSERT INTO public.lx_share_service_consents(user_id,agreement_version)
VALUES (current_setting('dev01b.a_uid')::uuid,'DEVTEST_ONLY_V5_TX_20261108'),(current_setting('dev01b.b_uid')::uuid,'DEVTEST_ONLY_V5_TX_20261108');
UPDATE public.lx_share_draft_details SET pickup_kind='collection_point',collection_point_id='11111111-1111-4111-8111-111111111115',pickup_address_snapshot=NULL WHERE request_id=current_setting('dev01b.b_request')::uuid;
-- ASSERTION MATRIX: expected rejection caught in PL/pgSQL subtransactions, no aborted outer transaction.
DO $$ DECLARE a uuid:=current_setting('dev01b.a_uid')::uuid; b uuid:=current_setting('dev01b.b_uid')::uuid; ra uuid:=current_setting('dev01b.a_request')::uuid; rb uuid:=current_setting('dev01b.b_request')::uuid; v jsonb; n integer; bag record; BEGIN
 PERFORM set_config('request.jwt.claim.sub',a::text,true);
 v:=public.lx_share_submission_preflight(ra); IF v->>'ready'<>'true' THEN RAISE EXCEPTION 'FAIL: home preflight %',v; END IF;
 PERFORM set_config('request.jwt.claim.sub',b::text,true);
 v:=public.lx_share_submission_preflight(rb); IF v->>'ready'<>'true' THEN RAISE EXCEPTION 'FAIL: point preflight %',v; END IF;
 -- Wrong agreement, missing checkbox, cross-user, nonexistent request: must reject.
 PERFORM set_config('request.jwt.claim.sub',a::text,true);
 BEGIN PERFORM public.lx_submit_share_request(ra,'WRONG',true,true,true); RAISE EXCEPTION 'FAIL: wrong version accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: wrong version accepted' THEN RAISE; END IF; END;
 BEGIN PERFORM public.lx_submit_share_request(ra,'DEVTEST_ONLY_V5_TX_20261108',true,false,true); RAISE EXCEPTION 'FAIL: checkbox accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: checkbox accepted' THEN RAISE; END IF; END;
 BEGIN PERFORM public.lx_submit_share_request(rb,'DEVTEST_ONLY_V5_TX_20261108',true,true,true); RAISE EXCEPTION 'FAIL: cross account accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: cross account accepted' THEN RAISE; END IF; END;
 BEGIN PERFORM public.lx_submit_share_request('22222222-2222-4222-8222-222222222222','DEVTEST_ONLY_V5_TX_20261108',true,true,true); RAISE EXCEPTION 'FAIL: nonexistent request accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: nonexistent request accepted' THEN RAISE; END IF; END;
 -- Invalid address must fail, then restore.
 UPDATE public.lx_share_draft_details SET pickup_address_snapshot=' ' WHERE request_id=ra;
 BEGIN PERFORM public.lx_submit_share_request(ra,'DEVTEST_ONLY_V5_TX_20261108',true,true,true); RAISE EXCEPTION 'FAIL: empty address accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: empty address accepted' THEN RAISE; END IF; END;
 UPDATE public.lx_share_draft_details SET pickup_address_snapshot='DEVTEST ONLY 台南市測試區虛構路100號' WHERE request_id=ra;
 -- Disabled collection point must fail, then restore.
 UPDATE public.lx_approved_collection_points SET enabled=false WHERE id='11111111-1111-4111-8111-111111111115';
 PERFORM set_config('request.jwt.claim.sub',b::text,true);
 BEGIN PERFORM public.lx_submit_share_request(rb,'DEVTEST_ONLY_V5_TX_20261108',true,true,true); RAISE EXCEPTION 'FAIL: disabled point accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: disabled point accepted' THEN RAISE; END IF; END;
 UPDATE public.lx_approved_collection_points SET enabled=true WHERE id='11111111-1111-4111-8111-111111111115';
 PERFORM set_config('request.jwt.claim.sub',a::text,true);
 -- Consent idempotency: repeat with ON CONFLICT DO NOTHING, assert single row.
 INSERT INTO public.lx_share_service_consents(user_id,agreement_version) VALUES (a,'DEVTEST_ONLY_V5_TX_20261108') ON CONFLICT DO NOTHING;
 SELECT count(*) INTO n FROM public.lx_share_service_consents WHERE user_id=a AND agreement_version='DEVTEST_ONLY_V5_TX_20261108';
 IF n<>1 THEN RAISE EXCEPTION 'FAIL: consent uniqueness'; END IF;
 -- Invalid photo must fail without changing draft state.
 UPDATE public.lx_share_draft_details SET placement_photo_path=a::text||'/'||ra::text||'/12345678-missing.png' WHERE request_id=ra;
 BEGIN PERFORM public.lx_submit_share_request(ra,'DEVTEST_ONLY_V5_TX_20261108',true,true,true); RAISE EXCEPTION 'FAIL: missing photo accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: missing photo accepted' THEN RAISE; END IF; END;
 IF EXISTS(SELECT 1 FROM public.lx_share_bags WHERE share_request_id=ra) THEN RAISE EXCEPTION 'FAIL: bag after rejection';END IF;
 UPDATE public.lx_share_draft_details SET placement_photo_path=current_setting('dev01b.a_photo') WHERE request_id=ra;
 -- Successful home submission.
 PERFORM public.lx_submit_share_request(ra,'DEVTEST_ONLY_V5_TX_20261108',true,true,true);
 SELECT * INTO bag FROM public.lx_share_bags WHERE share_request_id=ra;
 IF bag.id IS NULL OR bag.pickup_kind<>'home' OR bag.pickup_deadline_at<>bag.declared_at+interval '48 hours' OR bag.placement_photo_path<>current_setting('dev01b.a_photo') OR bag.bag_code !~ '^LS-[0-9]{6}-[0-9]{6,}$' THEN RAISE EXCEPTION 'FAIL: home bag incorrect'; END IF;
 BEGIN PERFORM public.lx_submit_share_request(ra,'DEVTEST_ONLY_V5_TX_20261108',true,true,true); RAISE EXCEPTION 'FAIL: duplicate accepted'; EXCEPTION WHEN OTHERS THEN IF SQLERRM='FAIL: duplicate accepted' THEN RAISE; END IF; END;
 PERFORM set_config('request.jwt.claim.sub',b::text,true);
 PERFORM public.lx_submit_share_request(rb,'DEVTEST_ONLY_V5_TX_20261108',true,true,true);
 SELECT * INTO bag FROM public.lx_share_bags WHERE share_request_id=rb;
 IF bag.id IS NULL OR bag.pickup_kind<>'collection_point' OR bag.collection_point_id<>'11111111-1111-4111-8111-111111111115'::uuid OR bag.pickup_location<>'DEVTEST ONLY 台南市虛構路200號' OR bag.pickup_deadline_at<>bag.declared_at+interval '48 hours' THEN RAISE EXCEPTION 'FAIL: collection bag incorrect'; END IF;
 SELECT count(*) INTO n FROM public.lx_share_bags WHERE share_request_id IN (ra,rb); IF n<>2 THEN RAISE EXCEPTION 'FAIL: bag count %',n;END IF;
 IF EXISTS(SELECT 1 FROM public.lx_share_requests WHERE id IN (ra,rb) AND status<>'submitted') THEN RAISE EXCEPTION 'FAIL: request status'; END IF;
 RAISE NOTICE 'PASS: home, point, 48h, duplicate, cross-user, invalid photo, version, checkbox, atomicity';
END $$;
-- This MUST be the last transaction statement. nextval() is non-transactional.
ROLLBACK;
-- Independent read-only postflight must be executed in a NEW connection.
